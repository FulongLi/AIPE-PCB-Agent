{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component.schema.json",
  "title": "Component knowledge record (design knowledge, not a full parametric database)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "manufacturer", "part_number", "category", "description", "package",
               "key_parameters", "application_conditions", "design_considerations", "datasheet",
               "reference_usage", "alternatives", "external_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "common.schema.json#/$defs/component_id"},
    "manufacturer": {"$ref": "common.schema.json#/$defs/text"},
    "part_number": {"type": "string", "minLength": 3},
    "orderable_variants": {"type": "array", "items": {"type": "string"}},
    "category": {"enum": ["driver_ics", "isolated_supplies", "capacitors", "sensors", "protection", "magnetics"]},
    "description": {"$ref": "common.schema.json#/$defs/text"},
    "package": {"type": "string", "minLength": 2},
    "key_parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "source"],
        "properties": {
          "name": {"$ref": "common.schema.json#/$defs/text"},
          "value": {"type": "string", "minLength": 1},
          "unit": {"type": "string"},
          "condition": {"type": "string"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document", "location"],
            "properties": {
              "document": {"enum": ["datasheet", "reference"]},
              "reference": {"$ref": "common.schema.json#/$defs/reference_id"},
              "reference_document": {"type": "string"},
              "location": {"$ref": "common.schema.json#/$defs/text"}
            }
          }
        }
      }
    },
    "application_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "design_considerations": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "datasheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "url_status"],
      "properties": {
        "url": {"type": ["string", "null"]},
        "url_status": {"enum": ["verified-pdf", "unverified", "not-located"]},
        "revision": {"type": "string"},
        "note": {"type": "string"},
        "acquisition": {"$ref": "common.schema.json#/$defs/acquisition"}
      }
    },
    "reference_usage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "refdes", "role", "evidence"],
        "properties": {
          "reference": {"$ref": "common.schema.json#/$defs/reference_id"},
          "refdes": {"type": "string", "minLength": 1},
          "role": {"$ref": "common.schema.json#/$defs/text"},
          "evidence": {"$ref": "common.schema.json#/$defs/evidence_list"}
        }
      }
    },
    "alternatives": {
      "$comment": "Only alternatives named by a cited source. Never inferred equivalence.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part_or_family", "manufacturer", "relationship", "evidence"],
        "properties": {
          "part_or_family": {"type": "string", "minLength": 2},
          "manufacturer": {"type": "string", "minLength": 2},
          "relationship": {"$ref": "common.schema.json#/$defs/text"},
          "evidence": {"$ref": "common.schema.json#/$defs/evidence_list"}
        }
      }
    },
    "external_refs": {
      "$comment": "Integration keys for existing AIPE component databases; null until linked.",
      "type": "object",
      "additionalProperties": false,
      "required": ["aipe_component_db"],
      "properties": {
        "aipe_component_db": {"type": ["string", "null"]},
        "aipe_transistor_db": {"type": ["string", "null"]}
      }
    },
    "keywords": {"type": "array", "items": {"type": "string", "minLength": 2}},
    "related": {"$ref": "common.schema.json#/$defs/related"}
  }
}
