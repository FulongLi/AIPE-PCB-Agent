{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill.schema.json",
  "title": "Engineering Skill (machine-readable index of a Markdown skill document)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "domain", "document", "purpose", "applicable_conditions",
               "not_applicable", "principles", "procedure", "component_considerations", "pcb_constraints",
               "verification_methods", "known_limitations", "sources", "related", "validation_status"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "common.schema.json#/$defs/skill_id"},
    "title": {"$ref": "common.schema.json#/$defs/text"},
    "domain": {"enum": ["power_electronics", "gate_drivers", "capacitors", "sensing", "thermal", "pcb_layout"]},
    "document": {"type": "string", "pattern": "\\.md$"},
    "purpose": {"$ref": "common.schema.json#/$defs/text"},
    "applicable_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "not_applicable": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "principles": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "procedure": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "component_considerations": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "pcb_constraints": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "verification_methods": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "known_limitations": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "keywords": {"type": "array", "items": {"type": "string", "minLength": 2}},
    "sources": {"$ref": "common.schema.json#/$defs/evidence_list"},
    "related": {"$ref": "common.schema.json#/$defs/related"},
    "validation_status": {"$ref": "common.schema.json#/$defs/validation_status"}
  }
}
