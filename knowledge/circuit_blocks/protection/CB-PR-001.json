  "id": "CB-PR-001",
  "name": "Auxiliary input protection for gate-driver bias rails",
  "category": "protection",
  "function": "Protects the 12 V auxiliary input feeding isolated bias supplies against overvoltage, reverse polarity and overload.",
  "inputs": [
    {
      "name": "VIN_AUX",
      "description": "external 12 V",
      "domain": "auxiliary"
    }
  ],
  "outputs": [
