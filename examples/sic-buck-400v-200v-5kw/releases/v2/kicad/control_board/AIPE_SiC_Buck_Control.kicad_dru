(version 1)
# Design basis: examples/sic-buck-400v-200v-5kw/design/design_decisions.json (schema 3, 2026-10-10) - single source of truth; electrical model automation/kicad_tools/sic_buck_control_model.py; generator automation/kicad_tools/generate_sic_schematics.py.
# 400 V (360-440 V) to 200 V / 25 A / 5 kW / 50 kHz synchronous buck; Wolfspeed C4MS025120K; TMS320F28335 control board on a stacked SELV mezzanine.
# AI-GENERATED ENGINEERING PROTOTYPE - V2 - HUMAN REVIEW REQUIRED
# Rule order matters: later rules override earlier ones. Net-class clearances (project file) apply first.
(rule "HV functional clearance (inner layers)" (layer inner)
  (condition "(((A.NetClass == 'HV_VIN') && (B.NetClass == 'HV_SW' || B.NetClass == 'DRV_HS' || B.NetClass == 'DESAT_HS')) || ((A.NetClass == 'HV_SW' || A.NetClass == 'DRV_HS' || A.NetClass == 'DESAT_HS') && (B.NetClass == 'HV_VIN'))) || (((A.NetClass == 'HV_VIN') && (B.NetClass == 'HV_PGND' || B.NetClass == 'DRV_LS' || B.NetClass == 'DESAT_LS' || B.NetClass == 'SENSE_ISO')) || ((A.NetClass == 'HV_PGND' || A.NetClass == 'DRV_LS' || A.NetClass == 'DESAT_LS' || A.NetClass == 'SENSE_ISO') && (B.NetClass == 'HV_VIN'))) || (((A.NetClass == 'HV_VIN') && (B.NetClass == 'HV_VOUT')) || ((A.NetClass == 'HV_VOUT') && (B.NetClass == 'HV_VIN'))) || (((A.NetClass == 'HV_SW' || A.NetClass == 'DRV_HS' || A.NetClass == 'DESAT_HS') && (B.NetClass == 'HV_PGND' || B.NetClass == 'DRV_LS' || B.NetClass == 'DESAT_LS' || B.NetClass == 'SENSE_ISO')) || ((A.NetClass == 'HV_PGND' || A.NetClass == 'DRV_LS' || A.NetClass == 'DESAT_LS' || A.NetClass == 'SENSE_ISO') && (B.NetClass == 'HV_SW' || B.NetClass == 'DRV_HS' || B.NetClass == 'DESAT_HS'))) || (((A.NetClass == 'HV_SW' || A.NetClass == 'DRV_HS' || A.NetClass == 'DESAT_HS') && (B.NetClass == 'HV_VOUT')) || ((A.NetClass == 'HV_VOUT') && (B.NetClass == 'HV_SW' || B.NetClass == 'DRV_HS' || B.NetClass == 'DESAT_HS'))) || (((A.NetClass == 'HV_PGND' || A.NetClass == 'DRV_LS' || A.NetClass == 'DESAT_LS' || A.NetClass == 'SENSE_ISO') && (B.NetClass == 'HV_VOUT')) || ((A.NetClass == 'HV_VOUT') && (B.NetClass == 'HV_PGND' || B.NetClass == 'DRV_LS' || B.NetClass == 'DESAT_LS' || B.NetClass == 'SENSE_ISO'))) || ((A.NetClass == 'HV_VIN' && B.NetClass == 'HV_VIN')) || ((A.NetClass == 'HV_SW' && B.NetClass == 'HV_SW')) || ((A.NetClass == 'HV_PGND' && B.NetClass == 'HV_PGND')) || ((A.NetClass == 'HV_VOUT' && B.NetClass == 'HV_VOUT'))")
  (constraint clearance (min 1mm)))
(rule "HV functional clearance (outer layers)" (layer outer)
  (condition "(((A.NetClass == 'HV_VIN') && (B.NetClass == 'HV_SW' || B.NetClass == 'DRV_HS' || B.NetClass == 'DESAT_HS')) || ((A.NetClass == 'HV_SW' || A.NetClass == 'DRV_HS' || A.NetClass == 'DESAT_HS') && (B.NetClass == 'HV_VIN'))) || (((A.NetClass == 'HV_VIN') && (B.NetClass == 'HV_PGND' || B.NetClass == 'DRV_LS' || B.NetClass == 'DESAT_LS' || B.NetClass == 'SENSE_ISO')) || ((A.NetClass == 'HV_PGND' || A.NetClass == 'DRV_LS' || A.NetClass == 'DESAT_LS' || A.NetClass == 'SENSE_ISO') && (B.NetClass == 'HV_VIN'))) || (((A.NetClass == 'HV_VIN') && (B.NetClass == 'HV_VOUT')) || ((A.NetClass == 'HV_VOUT') && (B.NetClass == 'HV_VIN'))) || (((A.NetClass == 'HV_SW' || A.NetClass == 'DRV_HS' || A.NetClass == 'DESAT_HS') && (B.NetClass == 'HV_PGND' || B.NetClass == 'DRV_LS' || B.NetClass == 'DESAT_LS' || B.NetClass == 'SENSE_ISO')) || ((A.NetClass == 'HV_PGND' || A.NetClass == 'DRV_LS' || A.NetClass == 'DESAT_LS' || A.NetClass == 'SENSE_ISO') && (B.NetClass == 'HV_SW' || B.NetClass == 'DRV_HS' || B.NetClass == 'DESAT_HS'))) || (((A.NetClass == 'HV_SW' || A.NetClass == 'DRV_HS' || A.NetClass == 'DESAT_HS') && (B.NetClass == 'HV_VOUT')) || ((A.NetClass == 'HV_VOUT') && (B.NetClass == 'HV_SW' || B.NetClass == 'DRV_HS' || B.NetClass == 'DESAT_HS'))) || (((A.NetClass == 'HV_PGND' || A.NetClass == 'DRV_LS' || A.NetClass == 'DESAT_LS' || A.NetClass == 'SENSE_ISO') && (B.NetClass == 'HV_VOUT')) || ((A.NetClass == 'HV_VOUT') && (B.NetClass == 'HV_PGND' || B.NetClass == 'DRV_LS' || B.NetClass == 'DESAT_LS' || B.NetClass == 'SENSE_ISO'))) || ((A.NetClass == 'HV_VIN' && B.NetClass == 'HV_VIN')) || ((A.NetClass == 'HV_SW' && B.NetClass == 'HV_SW')) || ((A.NetClass == 'HV_PGND' && B.NetClass == 'HV_PGND')) || ((A.NetClass == 'HV_VOUT' && B.NetClass == 'HV_VOUT'))")
  (constraint clearance (min 3mm)))
(rule "Same reference island (SW island, PGND island)"
  (condition "(((A.NetClass == 'HV_SW') && (B.NetClass == 'DRV_HS' || B.NetClass == 'DESAT_HS')) || ((A.NetClass == 'DRV_HS' || A.NetClass == 'DESAT_HS') && (B.NetClass == 'HV_SW'))) || (((A.NetClass == 'HV_PGND') && (B.NetClass == 'DRV_LS' || B.NetClass == 'DESAT_LS' || B.NetClass == 'SENSE_ISO')) || ((A.NetClass == 'DRV_LS' || A.NetClass == 'DESAT_LS' || A.NetClass == 'SENSE_ISO') && (B.NetClass == 'HV_PGND')))")
  (constraint clearance (min 0.3mm)))
(rule "HV side to PE"
  (condition "((A.NetClass == 'HV_VIN' || A.NetClass == 'HV_SW' || A.NetClass == 'HV_PGND' || A.NetClass == 'HV_VOUT' || A.NetClass == 'DRV_HS' || A.NetClass == 'DESAT_HS' || A.NetClass == 'DRV_LS' || A.NetClass == 'DESAT_LS' || A.NetClass == 'SENSE_ISO') && (B.NetClass == 'PE')) || ((A.NetClass == 'PE') && (B.NetClass == 'HV_VIN' || B.NetClass == 'HV_SW' || B.NetClass == 'HV_PGND' || B.NetClass == 'HV_VOUT' || B.NetClass == 'DRV_HS' || B.NetClass == 'DESAT_HS' || B.NetClass == 'DRV_LS' || B.NetClass == 'DESAT_LS' || B.NetClass == 'SENSE_ISO'))")
  (constraint clearance (min 5mm)))
(rule "HV side to CTRL_SELV (all layers)"
  (condition "((A.NetClass == 'HV_VIN' || A.NetClass == 'HV_SW' || A.NetClass == 'HV_PGND' || A.NetClass == 'HV_VOUT' || A.NetClass == 'DRV_HS' || A.NetClass == 'DESAT_HS' || A.NetClass == 'DRV_LS' || A.NetClass == 'DESAT_LS' || A.NetClass == 'SENSE_ISO') && (B.NetClass == 'CTRL_SELV' || B.NetClass == 'CTRL_PWR' || B.NetClass == 'Default')) || ((A.NetClass == 'CTRL_SELV' || A.NetClass == 'CTRL_PWR' || A.NetClass == 'Default') && (B.NetClass == 'HV_VIN' || B.NetClass == 'HV_SW' || B.NetClass == 'HV_PGND' || B.NetClass == 'HV_VOUT' || B.NetClass == 'DRV_HS' || B.NetClass == 'DESAT_HS' || B.NetClass == 'DRV_LS' || B.NetClass == 'DESAT_LS' || B.NetClass == 'SENSE_ISO'))")
  (constraint clearance (min 9mm)))
(rule "HV side to board edge"
  (condition "(A.NetClass == 'HV_VIN' || A.NetClass == 'HV_SW' || A.NetClass == 'HV_PGND' || A.NetClass == 'HV_VOUT' || A.NetClass == 'DRV_HS' || A.NetClass == 'DESAT_HS' || A.NetClass == 'DRV_LS' || A.NetClass == 'DESAT_LS' || A.NetClass == 'SENSE_ISO')")
  (constraint edge_clearance (min 1mm)))
# Pin-field exceptions derived from pad geometry, one per footprint and class pair: 0 barrier (HV side to SELV inside a barrier package - the 1.2 mm isolation slot is mandatory), 0 HV (package shorter than the HV rule - creepage review), 4 pitch (0.65 mm pitch leaves 0.15-0.2 mm between pads - fabricator confirmation).
(rule "pin field U13 CTRL_PWR-CTRL_SELV (pitch)"
  (condition "A.memberOfFootprint('U13') && B.intersectsCourtyard('U13') && (((A.NetClass == 'CTRL_PWR') && (B.NetClass == 'CTRL_SELV')) || ((A.NetClass == 'CTRL_SELV') && (B.NetClass == 'CTRL_PWR')))")
  (constraint clearance (min 0.14mm)))
(rule "pin field U13 CTRL_SELV-CTRL_SELV (pitch)"
  (condition "A.memberOfFootprint('U13') && B.intersectsCourtyard('U13') && (A.NetClass == 'CTRL_SELV' && B.NetClass == 'CTRL_SELV')")
  (constraint clearance (min 0.14mm)))
(rule "pin field U14 CTRL_PWR-CTRL_SELV (pitch)"
  (condition "A.memberOfFootprint('U14') && B.intersectsCourtyard('U14') && (((A.NetClass == 'CTRL_PWR') && (B.NetClass == 'CTRL_SELV')) || ((A.NetClass == 'CTRL_SELV') && (B.NetClass == 'CTRL_PWR')))")
  (constraint clearance (min 0.14mm)))
(rule "pin field U14 CTRL_SELV-CTRL_SELV (pitch)"
  (condition "A.memberOfFootprint('U14') && B.intersectsCourtyard('U14') && (A.NetClass == 'CTRL_SELV' && B.NetClass == 'CTRL_SELV')")
  (constraint clearance (min 0.14mm)))
