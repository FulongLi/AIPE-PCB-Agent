(version 1)
(rule "Reinforced hazardous-control barrier, all copper layers" (condition "(A.NetClass == 'CTRL' && B.NetClass != 'CTRL') || (B.NetClass == 'CTRL' && A.NetClass != 'CTRL')") (constraint clearance (min 8.0)))
