(version 1)
(rule "Reinforced HV-to-SELV separation, every copper layer (reference 8.0 mm, to be reviewed)" (condition "(A.NetClass == 'CTRL' && (B.NetClass == 'HV_00' || B.NetClass == 'HV_01' || B.NetClass == 'HV_02' || B.NetClass == 'HV_03' || B.NetClass == 'HV_04' || B.NetClass == 'HV_05' || B.NetClass == 'HV_06' || B.NetClass == 'HV_07' || B.NetClass == 'HV_08' || B.NetClass == 'HV_09' || B.NetClass == 'HV_10' || B.NetClass == 'HV_11' || B.NetClass == 'HV_12' || B.NetClass == 'HV_13' || B.NetClass == 'HV_14' || B.NetClass == 'HV_15' || B.NetClass == 'HV_16' || B.NetClass == 'HV_17' || B.NetClass == 'HV_18' || B.NetClass == 'HV_19' || B.NetClass == 'HV_20')) || (B.NetClass == 'CTRL' && (A.NetClass == 'HV_00' || A.NetClass == 'HV_01' || A.NetClass == 'HV_02' || A.NetClass == 'HV_03' || A.NetClass == 'HV_04' || A.NetClass == 'HV_05' || A.NetClass == 'HV_06' || A.NetClass == 'HV_07' || A.NetClass == 'HV_08' || A.NetClass == 'HV_09' || A.NetClass == 'HV_10' || A.NetClass == 'HV_11' || A.NetClass == 'HV_12' || A.NetClass == 'HV_13' || A.NetClass == 'HV_14' || A.NetClass == 'HV_15' || A.NetClass == 'HV_16' || A.NetClass == 'HV_17' || A.NetClass == 'HV_18' || A.NetClass == 'HV_19' || A.NetClass == 'HV_20'))") (constraint clearance (min 8.0mm)))
(rule "Hazardous copper to board edge" (condition "A.NetClass != 'CTRL'") (constraint edge_clearance (min 1.0mm)))
(rule "SELV copper to board edge" (condition "A.NetClass == 'CTRL'") (constraint edge_clearance (min 0.5mm)))
(rule "Functional HV_00-HV_01 860 V working envelope" (condition "(A.NetClass == 'HV_00' && B.NetClass == 'HV_01') || (A.NetClass == 'HV_01' && B.NetClass == 'HV_00')") (constraint clearance (min 4.3mm)))
